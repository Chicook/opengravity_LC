# Copia este fichero a `.env` y rellena lo que uses.
# Ninguna clave es obligatoria: con Ollama local funciona sin configurar nada.

# Directorio donde se guardan las sesiones (por defecto ~/.agent-ide)
# AGENT_IDE_HOME=/ruta/a/mis/sesiones

# OpenAI (o cualquier endpoint OpenAI-compatible: vLLM, LM Studio, OpenRouter…)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=...

# Ollama se autodetecta en http://127.0.0.1:11434
